[Unit]
Description=Signal Engine Poll
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/media/nas/workspaces/EmailScanning
EnvironmentFile=/media/nas/workspaces/EmailScanning/.env
Environment=VAULT_ENV_FILE=/home/rod/.config/vaultsolution/vault.env
ExecStart=/usr/bin/npm run poll:vault
Nice=10

[Install]
WantedBy=multi-user.target
