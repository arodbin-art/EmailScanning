{
  "name": "email-scanning-admin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "node --no-warnings --loader ts-node/esm src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test:auth": "node --test --no-warnings --loader ts-node/esm src/auth.test.ts",
    "test:templates:routes": "node --test --no-warnings --loader ts-node/esm src/templates.routes.test.ts",
    "test:templates": "node --test --no-warnings --loader ts-node/esm src/templates.test.ts",
    "test": "npm run test:auth && npm run test:templates",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
    "start:vault": "./scripts/run_with_hcv.sh node dist/index.js",
    "dev:vault": "./scripts/run_with_hcv.sh node --no-warnings --loader ts-node/esm src/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  }
}
