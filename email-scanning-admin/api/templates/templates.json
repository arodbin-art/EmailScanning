{
  "version": 1,
  "templates": [
    {
      "id": "amazon-default",
      "name": "Amazon (returns lifecycle)",
      "description": "Return requested, dropped off, refund issued",
      "tags": ["amazon", "returns"],
      "version": "1.0.0",
      "monitor_defaults": {
        "provider": "gmail",
        "sender_rules": ["return@amazon.ca"],
        "subject_regex": ".*",
        "body_regex": null,
        "event_family_prefixes": ["amazon."],
        "allowed_event_types": [
          "amazon.return_requested",
          "amazon.return_dropped_off",
          "amazon.refund_issued"
        ],
        "enabled": false
      }
    },
    {
      "id": "manulife-claims",
      "name": "Manulife claims updates",
      "description": "Claim lifecycle updates from Manulife emails",
      "tags": ["manulife", "claims", "insurance"],
      "version": "1.0.0",
      "monitor_defaults": {
        "provider": "gmail",
        "sender_rules": ["noreply@email.manulife.ca"],
        "subject_regex": "^We've checked your claims$",
        "body_regex": "Your latest claims",
        "event_family_prefixes": ["manulife."],
        "allowed_event_types": [
          "manulife.claim_received",
          "manulife.claim_processed",
          "manulife.claim_paid",
          "manulife.claim_denied",
          "manulife.claim_info_required",
          "manulife.claim_status_update"
        ],
        "enabled": false
      }
    },
    {
      "id": "durham-orthodontics-approved-payment",
      "name": "Durham Orthodontics approved payment",
      "description": "Approved payment notifications from Elavon",
      "tags": ["orthodontics", "payment", "elavon"],
      "version": "1.0.0",
      "monitor_defaults": {
        "provider": "gmail",
        "sender_rules": ["noreply@elavon.com"],
        "subject_regex": "^Approved Payment$",
        "body_regex": "Durham Orthodontics Ajax",
        "event_family_prefixes": ["orthodontics."],
        "allowed_event_types": ["orthodontics.payment_approved"],
        "enabled": false
      }
    },
    {
      "id": "durham-orthodontics-appointments",
      "name": "Durham Orthodontics appointments",
      "description": "Appointment scheduled and reminder notifications",
      "tags": ["orthodontics", "appointments"],
      "version": "1.0.0",
      "monitor_defaults": {
        "provider": "gmail",
        "sender_rules": ["info@durhamorthodontics.ca"],
        "subject_regex": "(An Orthodontic Appointment Has Been Scheduled|Appointment Reminder)",
        "body_regex": null,
        "event_family_prefixes": ["orthodontics."],
        "allowed_event_types": [
          "orthodontics.appointment_scheduled",
          "orthodontics.appointment_reminder"
        ],
        "enabled": false
      }
    }
  ]
}
