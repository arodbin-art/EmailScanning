{
  "name": "signal-engine",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "poll": "node --no-warnings ./dist/ingestion/index.js",
    "retention:check": "node --no-warnings ./dist/maintenance/retentionCheck.js",
    "deliver": "node --no-warnings ./dist/delivery/index.js",
    "deliver:backfill:amazon": "node --no-warnings ./dist/delivery/backfillAmazonRejected.js",
    "replay:amazon": "node --no-warnings ./dist/automation/amazonReturnReplay.js",
    "replay:manulife": "node --no-warnings ./dist/automation/manulifeClaimReplay.js",
    "replay:orthodontics": "node --no-warnings ./dist/automation/orthodonticsPaymentReplay.js",
    "compare:intelligence": "node --no-warnings ./dist/analysis/compareDeterministicVsAi.js",
    "backfill:intelligence": "node --no-warnings ./dist/analysis/backfillAiCandidates.js",
    "run:scheduled": "node --no-warnings ./dist/ops/runScheduledCycle.js",
    "test:amazon:return-parser": "tsc -p tsconfig.json && node --no-warnings dist/automation/amazonReturnParserTest.js",
    "test:amazon": "tsc -p tsconfig.json && node --no-warnings dist/automation/amazonReturnParserTest.js",
    "test:manulife": "tsc -p tsconfig.json && node --no-warnings dist/automation/manulifeClaimParserTest.js",
    "test:orthodontics": "tsc -p tsconfig.json && node --no-warnings dist/automation/orthodonticsPaymentParserTest.js && node --no-warnings dist/automation/orthodonticsAppointmentParserTest.js",
    "test:delivery:descriptions": "tsc -p tsconfig.json && node --no-warnings dist/delivery/descriptionFormatterTest.js",
    "test:igpt": "tsc -p tsconfig.json && node --no-warnings dist/intelligence/igptProviderTest.js",
    "test:intelligence:shadow": "tsc -p tsconfig.json && node --no-warnings dist/intelligence/shadowRuntimeTest.js",
    "test:ingestion:entrypoint": "tsc -p tsconfig.json && node --no-warnings dist/ingestion/indexTest.js",
    "test:delivery:auth": "tsc -p tsconfig.json && node --no-warnings dist/delivery/authTokenProviderTest.js",
    "test:delivery:money-recovery": "tsc -p tsconfig.json && node --no-warnings dist/delivery/moneyRecoveryClientTest.js",
    "poll:vault": "./ops/vault/run_with_hcv.sh ./ops/vault/hcv-main.envmap -- node --no-warnings ./dist/ingestion/index.js",
    "deliver:vault": "./ops/vault/run_with_hcv.sh ./ops/vault/hcv-main.envmap -- node --no-warnings ./dist/delivery/index.js",
    "run:scheduled:vault": "./ops/vault/run_with_hcv.sh ./ops/vault/hcv-main.envmap -- node --no-warnings ./dist/ops/runScheduledCycle.js",
    "retention:check:vault": "./ops/vault/run_with_hcv.sh ./ops/vault/hcv-main.envmap -- node --no-warnings ./dist/maintenance/retentionCheck.js",
    "verify:secrets": "/media/nas/workspaces/vaultSolution/bin/verify-no-secrets /media/nas/workspaces/EmailScanning"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.749.0",
    "@azure/storage-blob": "^12.17.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "googleapis": "^140.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "typescript": "^5.5.4"
  }
}
