// Prisma schema for Signal Engine (email ingestion)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

enum EmailMonitorStatusState {
  ignored
  processed
  errored

  @@map("email_monitor_status_state")
}

enum EventsOutboxStatus {
  pending
  delivered
  needs_review
  rejected

  @@map("events_outbox_status")
}

model MailAccount {
  id                       Int        @id @default(autoincrement())
  provider                 String     @db.VarChar(50)
  accountLabel             String     @map("account_label") @db.VarChar(100)
  mailboxAddress           String     @map("mailbox_address") @db.VarChar(320)
  authType                 String     @map("auth_type") @db.VarChar(50)
  encryptedCredentialsRef  String     @map("encrypted_credentials_ref") @db.Text
  moneyRecoveryPersonCode  String?    @map("moneyrecovery_person_code") @db.Text
  enabled                  Boolean    @default(true)
  createdAt                DateTime   @map("created_at") @db.Timestamp(6)
  emails                   EmailRaw[]

  @@map("mail_accounts")
}

model EmailRaw {
  id                  Int                  @id @default(autoincrement())
  mailAccountId       Int                  @map("mail_account_id")
  provider            String               @db.VarChar(50)
  messageId           String               @map("message_id") @db.Text
  threadId            String?              @map("thread_id") @db.Text
  fromAddress         String               @map("from_address") @db.Text
  subject             String?              @db.Text
  receivedAt          DateTime             @map("received_at") @db.Timestamp(6)
  bodyHash            String               @map("body_hash") @db.Char(64)
  bodyObjectKey       String               @map("body_object_key") @db.Text
  attachmentMetadata  Json?                @map("attachment_metadata")
  firstSeenAt         DateTime             @map("first_seen_at") @db.Timestamp(6)
  lastSeenAt          DateTime             @map("last_seen_at") @db.Timestamp(6)
  mailAccount         MailAccount          @relation(fields: [mailAccountId], references: [id])
  monitorStatuses     EmailMonitorStatus[]
  aiInferenceRuns     AiInferenceRun[]
  eventsOutbox        EventsOutbox[]
  monitorMatches      MonitorMatch[]
  amazonRefundProcessed AmazonRefundProcessed[]
  amazonRefundDiscrepancies AmazonRefundDiscrepancy[]
  amazonReturnNearMiss AmazonReturnNearMiss?
  manulifeClaimNearMiss ManulifeClaimNearMiss?

  @@unique([mailAccountId, messageId])
  @@map("emails_raw")
}

model EmailMonitorStatus {
  emailId     Int                     @map("email_id")
  monitorId   String                  @map("monitor_id") @db.Text
  status      EmailMonitorStatusState
  evaluatedAt DateTime                @map("evaluated_at") @db.Timestamp(6)
  email       EmailRaw                @relation(fields: [emailId], references: [id])

  @@id([emailId, monitorId])
  @@map("email_monitor_status")
}

model AiInferenceRun {
  id            Int       @id @default(autoincrement())
  emailId       Int       @map("email_id")
  monitorId     String    @map("monitor_id") @db.Text
  modelName     String    @map("model_name") @db.VarChar(100)
  promptVersion String    @map("prompt_version") @db.VarChar(50)
  outputJson    Json      @map("output_json")
  confidence    Decimal   @db.Decimal(4, 3)
  createdAt     DateTime  @map("created_at") @db.Timestamp(6)
  email         EmailRaw  @relation(fields: [emailId], references: [id])

  @@map("ai_inference_runs")
}

model EventsOutbox {
  id            Int               @id @default(autoincrement())
  dedupeKey     String            @unique @map("dedupe_key") @db.Char(32)
  eventType     String            @map("event_type") @db.VarChar(100)
  payloadJson   Json              @map("payload_json")
  sourceEmailId Int               @map("source_email_id")
  confidence    Decimal           @db.Decimal(4, 3)
  status        EventsOutboxStatus
  createdAt     DateTime          @map("created_at") @db.Timestamp(6)
  sourceEmail   EmailRaw          @relation(fields: [sourceEmailId], references: [id])
  deliveryLogs  EventsDeliveryLog[]

  @@map("events_outbox")
}

model AiCandidateEvent {
  id         String    @id @default(uuid()) @db.Text
  emailId    String    @map("email_id") @db.Text
  provider   String    @db.VarChar(50)
  eventType  String    @map("event_type") @db.VarChar(100)
  primaryRef String?   @map("primary_ref") @db.Text
  amount     Decimal?  @db.Decimal(12, 2)
  occurredAt DateTime? @map("occurred_at") @db.Timestamp(6)
  payloadJson Json     @map("payload_json")
  confidence Float?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([emailId])
  @@map("ai_candidate_events")
}

model EventsDeliveryLog {
  eventId     Int       @map("event_id")
  rviResponse Json      @map("rvi_response")
  deliveredAt DateTime  @map("delivered_at") @db.Timestamp(6)
  event       EventsOutbox @relation(fields: [eventId], references: [id])

  @@id([eventId, deliveredAt])
  @@map("events_delivery_log")
}

enum MonitorScope {
  all
  selected

  @@map("monitor_scope")
}

enum FilterDraftSessionStatus {
  draft
  questions_pending
  ready
  monitor_created
  cancelled

  @@map("filter_draft_session_status")
}

model Monitor {
  id                  String   @id @db.Text
  name                String   @db.VarChar(200)
  enabled             Boolean  @default(true)
  provider            String   @db.VarChar(50)
  captureKey          String?  @map("capture_key") @db.VarChar(120)
  senderRules         Json?    @map("sender_rules")
  fromContains        String?  @map("from_contains") @db.Text
  subjectContains     String?  @map("subject_contains") @db.Text
  subjectRegex        String?  @map("subject_regex") @db.Text
  bodyRegex           String?  @map("body_regex") @db.Text
  hasAttachments      Boolean? @map("has_attachments")
  gmailLabel          String?  @map("gmail_label") @db.Text
  scope               MonitorScope @default(all)
  mailAccountIds      Json?    @map("mail_account_ids")
  aiPromptTemplate    String?  @map("ai_prompt_template") @db.Text
  confidenceThreshold Decimal? @map("confidence_threshold") @db.Decimal(4, 3)
  allowedEventTypes   Json?    @map("allowed_event_types")
  createdAt           DateTime @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime @map("updated_at") @db.Timestamp(6)
  monitorMatches      MonitorMatch[]

  @@map("monitors")
}

model FilterDraftSession {
  id                String                   @id @db.Text
  name              String                   @db.VarChar(200)
  provider          String                   @db.VarChar(50)
  scope             MonitorScope             @default(all)
  mailAccountIds    Json?                    @map("mail_account_ids")
  status            FilterDraftSessionStatus
  analysisProvider  String                   @map("analysis_provider") @db.VarChar(50)
  analysisModel     String?                  @map("analysis_model") @db.VarChar(120)
  latestConfidence  Decimal?                 @map("latest_confidence") @db.Decimal(4, 3)
  latestSummaryJson Json?                    @map("latest_summary_json")
  monitorId         String?                  @map("monitor_id") @db.Text
  createdAt         DateTime                 @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime                 @map("updated_at") @db.Timestamp(6)
  samples           FilterDraftSample[]
  questions         FilterDraftQuestion[]
  answers           FilterDraftAnswer[]
  proposals         FilterDraftProposal[]

  @@map("filter_draft_sessions")
}

model FilterDraftSample {
  id             String             @id @db.Text
  sessionId      String             @map("session_id") @db.Text
  sampleIndex    Int                @map("sample_index")
  sourceKind     String             @map("source_kind") @db.VarChar(30)
  rawSource      String             @map("raw_source") @db.Text
  filename       String?            @db.Text
  fromAddress    String?            @map("from_address") @db.Text
  subject        String?            @db.Text
  bodyText       String?            @map("body_text") @db.Text
  bodyHtml       String?            @map("body_html") @db.Text
  normalizedBody String             @map("normalized_body") @db.Text
  parsedEmailJson Json?             @map("parsed_email_json")
  createdAt      DateTime           @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime           @map("updated_at") @db.Timestamp(6)
  session        FilterDraftSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, sampleIndex])
  @@map("filter_draft_samples")
}

model FilterDraftQuestion {
  id           String             @id @db.Text
  sessionId    String             @map("session_id") @db.Text
  questionKey  String             @map("question_key") @db.Text
  questionJson Json               @map("question_json")
  createdAt    DateTime           @map("created_at") @db.Timestamp(6)
  answeredAt   DateTime?          @map("answered_at") @db.Timestamp(6)
  session      FilterDraftSession @relation(fields: [sessionId], references: [id])
  answers      FilterDraftAnswer[]

  @@unique([sessionId, questionKey])
  @@map("filter_draft_questions")
}

model FilterDraftAnswer {
  id         String             @id @db.Text
  sessionId  String             @map("session_id") @db.Text
  questionId String             @map("question_id") @db.Text
  answerJson Json               @map("answer_json")
  createdAt  DateTime           @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime           @map("updated_at") @db.Timestamp(6)
  session    FilterDraftSession @relation(fields: [sessionId], references: [id])
  question   FilterDraftQuestion @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@map("filter_draft_answers")
}

model FilterDraftProposal {
  id              String             @id @db.Text
  sessionId       String             @map("session_id") @db.Text
  proposalJson    Json               @map("proposal_json")
  analysisJson    Json               @map("analysis_json")
  confidence      Decimal?           @db.Decimal(4, 3)
  createdMonitorId String?           @map("created_monitor_id") @db.Text
  createdAt       DateTime           @map("created_at") @db.Timestamp(6)
  session         FilterDraftSession @relation(fields: [sessionId], references: [id])

  @@map("filter_draft_proposals")
}

model MonitorMatch {
  emailId       Int       @map("email_id")
  monitorId     String    @map("monitor_id") @db.Text
  matchedAt     DateTime  @map("matched_at") @db.Timestamp(6)
  matchedFields Json      @map("matched_fields")
  email         EmailRaw  @relation(fields: [emailId], references: [id])
  monitor       Monitor   @relation(fields: [monitorId], references: [id])

  @@id([emailId, monitorId])
  @@map("monitor_matches")
}

model AmazonRefundProcessed {
  orderId     String   @id @map("order_id") @db.Text
  emailId     Int?     @map("email_id")
  processedAt DateTime @map("processed_at") @db.Timestamp(6)
  email       EmailRaw? @relation(fields: [emailId], references: [id])

  @@map("amazon_refund_processed")
}

model AmazonRefundDiscrepancy {
  id            Int      @id @default(autoincrement())
  orderId       String   @unique @map("order_id") @db.Text
  emailId       Int      @map("email_id")
  chargedAmount Decimal  @map("charged_amount") @db.Decimal(10, 2)
  refundedAmount Decimal @map("refunded_amount") @db.Decimal(10, 2)
  difference    Decimal  @map("difference") @db.Decimal(10, 2)
  subject       String?  @db.Text
  receivedAt    DateTime @map("received_at") @db.Timestamp(6)
  gmailLink     String?  @map("gmail_link") @db.Text
  createdAt     DateTime @map("created_at") @db.Timestamp(6)
  email         EmailRaw @relation(fields: [emailId], references: [id])

  @@map("amazon_refund_discrepancies")
}

model AmazonReturnNearMiss {
  emailId          Int      @id @map("email_id")
  provider         String   @db.VarChar(50)
  fromAddress      String   @map("from_address") @db.Text
  subject          String?  @db.Text
  receivedAt       DateTime @map("received_at") @db.Timestamp(6)
  orderId          String?  @map("order_id") @db.Text
  expectedEventType String? @map("expected_event_type") @db.VarChar(100)
  missingFields    Json?    @map("missing_fields")
  reason           String   @db.VarChar(100)
  snippet          String?  @db.Text
  aiSuggestion     Json?    @map("ai_suggestion")
  createdAt        DateTime @map("created_at") @db.Timestamp(6)
  email            EmailRaw @relation(fields: [emailId], references: [id])

  @@map("amazon_return_near_miss")
}

model ManulifeClaimNearMiss {
  emailId             Int      @id @map("email_id")
  provider            String   @db.VarChar(50)
  fromAddress         String   @map("from_address") @db.Text
  subject             String?  @db.Text
  receivedAt          DateTime @map("received_at") @db.Timestamp(6)
  claimId             String?  @map("claim_id") @db.Text
  statusText          String?  @map("status_text") @db.Text
  parseReason         String   @map("parse_reason") @db.VarChar(120)
  extractedCandidates Json?    @map("extracted_candidates")
  aiSuggestionJson    Json?    @map("ai_suggestion_json")
  snippet             String?  @db.Text
  createdAt           DateTime @map("created_at") @db.Timestamp(6)
  email               EmailRaw @relation(fields: [emailId], references: [id])

  @@map("manulife_claim_near_miss")
}
