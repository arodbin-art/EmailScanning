# Use the dedicated Signal Engine database and schema.
# Replace <PASSWORD> with the real password.
DATABASE_URL="postgres://emailscanninguser:<PASSWORD>@gift-tracker-db-rod.postgres.database.azure.com:5432/signal_engine?sslmode=require&schema=email_scanning"

# Object storage
STORAGE_PROVIDER=azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# S3-compatible (only used when STORAGE_PROVIDER=s3)
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Microsoft Graph (either provide a static access token or client-credentials)
GRAPH_ACCESS_TOKEN=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SCOPE=https://graph.microsoft.com/.default

# Gmail OAuth (readonly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth2callback
GMAIL_TOKEN_STORE_PATH=secrets/gmail_tokens.json
# 32-byte key (base64 or hex)
GMAIL_TOKEN_ENCRYPTION_KEY=
# Optional Gmail filters
GMAIL_LABEL_IDS=
GMAIL_QUERY=

# Account assignment (comma-separated ids)
MAIL_ACCOUNT_IDS=1,3,7

# Optional: run poll immediately when importing pollRunner
RUN_POLL_ON_START=false

# AI provider
AI_ENABLED=false
AI_PROVIDER=openai
# OPENAI_API_KEY is loaded from secrets/OpenAI.key when AI_ENABLED=true
OPENAI_MODEL=gpt-4o-mini
OPENAI_PROMPT_VERSION=v1

# Amazon AI fallback (Azure OpenAI)
AMAZON_AI_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=yasmine-suggest
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# RVI delivery
RVI_BASE_URL=
RVI_BEARER_TOKEN=
RVI_TIMEOUT_MS=10000
RVI_BATCH_SIZE=25

# Retention check (log-only)
RETENTION_DAYS=180
RETENTION_BLOB_PREFIX=emails/
