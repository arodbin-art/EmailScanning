# Use the dedicated Signal Engine database and schema.
# Replace <PASSWORD> with the real password.
DATABASE_URL="postgres://emailscanninguser:<PASSWORD>@gift-tracker-db-rod.postgres.database.azure.com:5432/signal_engine?sslmode=require&schema=email_scanning"

# Object storage
STORAGE_PROVIDER=azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# S3-compatible (only used when STORAGE_PROVIDER=s3)
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Microsoft Graph (either provide a static access token or client-credentials)
GRAPH_ACCESS_TOKEN=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SCOPE=https://graph.microsoft.com/.default

# Gmail OAuth (readonly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth2callback
GMAIL_TOKEN_STORE_PATH=/media/nas/workspaces/vaultSolution/runtime/email-scanning/gmail_tokens.json
# 32-byte key (base64 or hex)
GMAIL_TOKEN_ENCRYPTION_KEY=
# Optional: base64-encoded gmail token store JSON (for container deployments)
GMAIL_TOKEN_STORE_B64=
# Optional Gmail filters
GMAIL_LABEL_IDS=
GMAIL_QUERY=

# Account assignment (comma-separated ids)
MAIL_ACCOUNT_IDS=1,3,7

# AI provider
AI_ENABLED=false
AI_PROVIDER=openai
# OPENAI_API_KEY is loaded from secrets/OpenAI.key when AI_ENABLED=true
OPENAI_MODEL=gpt-4o-mini
OPENAI_PROMPT_VERSION=v1

# Amazon AI fallback (Azure OpenAI)
AMAZON_AI_ENABLED=false
MANULIFE_AI_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=yasmine-suggest
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# iGPT shadow mode (comparison only; does not emit outbox events)
IGPT_ENABLED=false
# Auth modes:
# - api_key (default): service API key only
# - auto: API key first, optionally session fallback when IGPT_SESSION_FALLBACK_ENABLED=true
# - api_key: force Bearer key flow against IGPT_BASE_URL
# - session: force x-token flow against IGPT_SESSION_BASE_URL
IGPT_AUTH_MODE=api_key
IGPT_API_KEY=
IGPT_BASE_URL=https://api.igpt.ai
# Disabled by default; enables session fallback only when IGPT_AUTH_MODE=auto
IGPT_SESSION_FALLBACK_ENABLED=false
# Session-token mode (used by https://igpt.ai web app)
IGPT_SESSION_TOKEN=
IGPT_SESSION_DEVICE_ID=
IGPT_SESSION_BASE_URL=https://igpt.ai/api/v1
IGPT_SESSION_USER_ID=
IGPT_TIMEOUT_MS=5000
IGPT_FALLBACK_ENABLED=false

# RVI delivery
RVI_BASE_URL=
# Legacy emergency fallback only. Prefer client credentials.
RVI_BEARER_TOKEN=
RVI_TIMEOUT_MS=10000
RVI_BATCH_SIZE=25
RVI_DELIVERY_KIND=money_recovery
# Unattended auth via Entra client credentials (default)
RVI_AUTH_MODE=client_credentials
RVI_AUTH_TENANT_ID=
RVI_AUTH_CLIENT_ID=
RVI_AUTH_CLIENT_SECRET=
RVI_AUTH_RESOURCE=
# Static mode is blocked unless explicitly enabled:
RVI_STATIC_BEARER_ALLOW=false

# Retention check (log-only)
RETENTION_DAYS=180
RETENTION_BLOB_PREFIX=emails/
